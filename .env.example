# Copy this file to .env and adjust the paths for THIS machine.
# .env is intentionally NOT committed to git (it's host-specific).

# --- GPU backend ---
# nvidia | rocm
# Set automatically by build.sh after you pick a backend there.
# On a machine that only ever ran import.sh (never build.sh), set
# this by hand to match the image tag you imported.
BACKEND=nvidia

# --- Image ---
IMAGE_NAME=comfyui-offline
# build.sh sets this to <backend>-latest automatically, e.g. nvidia-latest
IMAGE_TAG=nvidia-latest

# --- Networking ---
COMFY_PORT=8188

# --- Storage (all outside the image, all persist across restarts) ---
# Point MODELS_PATH at wherever the model files were copied to on
# this machine. See README.md for the folder layout ComfyUI expects.
MODELS_PATH=./data/models
INPUT_PATH=./data/input
OUTPUT_PATH=./data/output
USER_PATH=./data/user

# --- Runtime ---
# Extra ComfyUI command-line flags, space-separated, e.g.:
# CLI_ARGS=--lowvram --preview-method auto
CLI_ARGS=
